{
  "name": "erebes-full",
  "version": "2.0.0",
  "description": "Demonstrativo BACEN",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "dist": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": "https://github.com/Leandro1992/erebes.git",
  "keywords": [
    "Electron",
    "electron-builder",
    "Express",
    "demo",
    "ReactJS"
  ],
  "build": {
    "appId": "com.jamzi.bacer",
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "server.js",
      "controllers/**",
      "util/**",
      "validators/**",
      "front/build/**",
      "!front/build/**/*.map",
      "!dist/**",
      "!out/**",
      "!**/*.md",
      "!**/README*",
      "!**/.git/**",
      "!**/.vscode/**",
      "!**/test{,s}/**",
      "!**/*.spec.*",
      "!**/*.test.*"
    ],
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true
    }
  },
  "author": "GitHub",
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "electron": "^9.1.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "convert-excel-to-json": "git+https://github.com/Leandro1992/convert-excel-to-json.git",
    "electron-squirrel-startup": "^1.0.0",
    "express": "^4.17.1",
    "formidable": "^1.2.2",
    "js2xmlparser": "^4.0.1",
    "save": "^2.4.0"
  }
}
